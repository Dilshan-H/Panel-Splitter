{
  "id": "ed576e29",
  "name": "Panel Splitter",
  "version": "1.0.2",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "panelSplitter",
      "label": {
        "default": "Panel Splitter"
      },
      "minimumSize": {
        "width": 280,
        "height": 720
      },
      "maximumSize": {
        "width": 400,
        "height": 800
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 730
      },
      "preferredFloatingSize": {
        "width": 290,
        "height": 730
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-light.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-dark.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": ["https"]
    }
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/plugin-icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "light", "lightest", "all"]
    }
  ]
}
